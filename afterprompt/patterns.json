{
  "schema": 1,
  "about": "Credential patterns. Rust-regex compatible (ripgrep): no lookaround, no backreferences. Tier A = vendor-specific prefix or format; B = structural; C = contextual and weak. Each pattern runs as its own ripgrep pass. Flags: rotate_structural (a tier-B structure that is an unambiguous secret, reported under Rotate now), header_only (matches a fixed key header, not key material: review, not rotate), session_cookie (review: rotated by signing out), multiline (needs rg -U). See patterns.py.",
  "patterns": [
    {"name": "anthropic_key", "tier": "A", "regex": "\\bsk-ant-(?:api|admin|oat|ort)[0-9]{2}-[A-Za-z0-9_\\-]{80,}", "label": "Anthropic API key", "group": "AI / LLM providers", "revoke": {"where": "Anthropic Console", "url": "https://platform.claude.com/settings/keys"}, "vendor": "Anthropic", "vendor_icon": "anthropic"},
    {"name": "openai_project_key", "tier": "A", "regex": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_\\-]{40,}", "label": "OpenAI API key", "group": "AI / LLM providers", "revoke": {"where": "OpenAI Platform", "url": "https://platform.openai.com/api-keys"}, "vendor": "OpenAI", "vendor_icon": "openai"},
    {"name": "openai_legacy_key", "tier": "A", "regex": "\\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}\\b", "label": "OpenAI API key (legacy format)", "group": "AI / LLM providers", "revoke": {"where": "OpenAI Platform", "url": "https://platform.openai.com/api-keys"}, "vendor": "OpenAI", "vendor_icon": "openai"},
    {"name": "google_api_key", "tier": "A", "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b", "label": "Google API key", "group": "AI / LLM providers", "revoke": {"where": "Google Cloud credentials", "url": "https://console.cloud.google.com/apis/credentials"}, "vendor": "Google", "vendor_icon": "google"},
    {"name": "groq_key", "tier": "A", "regex": "\\bgsk_[A-Za-z0-9]{50,}\\b", "label": "Groq API key", "group": "AI / LLM providers", "revoke": {"where": "Groq Console", "url": "https://console.groq.com/keys"}, "vendor": "Groq"},
    {"name": "openrouter_key", "tier": "A", "regex": "\\bsk-or-v1-[a-f0-9]{64}\\b", "label": "OpenRouter API key", "group": "AI / LLM providers", "revoke": {"where": "OpenRouter keys", "url": "https://openrouter.ai/workspaces/default/keys"}, "vendor": "OpenRouter"},
    {"name": "huggingface_token", "tier": "A", "regex": "\\bhf_[A-Za-z0-9]{30,40}\\b", "label": "Hugging Face token", "group": "AI / LLM providers", "revoke": {"where": "Hugging Face tokens", "url": "https://huggingface.co/settings/tokens"}, "vendor": "Hugging Face", "vendor_icon": "huggingface"},
    {"name": "replicate_token", "tier": "A", "regex": "\\br8_[A-Za-z0-9]{37}\\b", "label": "Replicate API token", "group": "AI / LLM providers", "revoke": {"where": "Replicate API tokens", "url": "https://replicate.com/account/api-tokens"}, "vendor": "Replicate", "vendor_icon": "replicate"},
    {"name": "perplexity_key", "tier": "A", "regex": "\\bpplx-[A-Za-z0-9]{40,56}\\b", "label": "Perplexity API key", "group": "AI / LLM providers", "vendor": "Perplexity", "vendor_icon": "perplexity"},
    {"name": "elevenlabs_key", "tier": "A", "regex": "\\bsk_[a-f0-9]{48}\\b", "label": "ElevenLabs API key", "group": "AI / LLM providers", "revoke": {"where": "ElevenLabs API keys", "url": "https://elevenlabs.io/app/developers/api-keys"}, "vendor": "ElevenLabs", "vendor_icon": "elevenlabs"},
    {"name": "xai_key", "tier": "A", "regex": "xai-[A-Za-z0-9]{70,120}", "label": "xAI (Grok) API key", "group": "AI / LLM providers", "revoke": {"where": "xAI Console", "url": "https://console.x.ai"}, "note": "no \\b: keys appear glued to text", "vendor": "xAI", "vendor_icon": "x"},
    {"name": "deepgram_ctx", "tier": "A", "regex": "(?i)deepgram[a-z_]*[\\\"']?\\s*[:=]\\s*[\\\"']?[a-f0-9]{40}\\b", "label": "Deepgram API key", "group": "AI / LLM providers", "vendor": "Deepgram"},
    {"name": "assemblyai_ctx", "tier": "A", "regex": "(?i)assembly[a-z_]*key[\\\"']?\\s*[:=]\\s*[\\\"']?[a-f0-9]{32}\\b", "label": "AssemblyAI API key", "group": "AI / LLM providers", "vendor": "AssemblyAI"},
    {"name": "aws_access_key_id", "tier": "A", "regex": "\\b(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b", "label": "AWS access key ID", "group": "Cloud", "revoke": {"where": "AWS IAM security credentials", "url": "https://console.aws.amazon.com/iam/home#/security_credentials"}, "vendor": "AWS", "vendor_icon": "amazonwebservices"},
    {"name": "aws_secret_key_ctx", "tier": "A", "regex": "(?i)aws_?secret_?access_?key[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9/+=]{40}\\b", "label": "AWS secret access key", "group": "Cloud", "revoke": {"where": "AWS IAM security credentials", "url": "https://console.aws.amazon.com/iam/home#/security_credentials"}, "vendor": "AWS", "vendor_icon": "amazonwebservices"},
    {"name": "aws_session_token_ctx", "tier": "A", "regex": "(?i)aws_?session_?token[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9/+=]{100,}", "label": "AWS session token", "group": "Cloud", "revoke": {"where": "AWS IAM security credentials", "url": "https://console.aws.amazon.com/iam/home#/security_credentials"}, "vendor": "AWS", "vendor_icon": "amazonwebservices"},
    {"name": "azure_storage_key", "tier": "A", "regex": "AccountKey=[A-Za-z0-9+/]{80,}={0,2}", "label": "Azure Storage account key", "group": "Cloud", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure", "vendor_icon": "microsoftazure"},
    {"name": "azure_conn_string", "tier": "B", "regex": "DefaultEndpointsProtocol=https?;AccountName=[A-Za-z0-9]+", "label": "Azure Storage connection string", "group": "Cloud", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure", "vendor_icon": "microsoftazure"},
    {"name": "azure_sas_signature", "tier": "B", "regex": "[?&]sig=[A-Za-z0-9%+/=]{40,}", "label": "Azure SAS signature", "group": "Cloud", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure", "vendor_icon": "microsoftazure"},
    {"name": "azure_ad_client_secret", "tier": "A", "regex": "(?i)(?:client_?secret|azure_client_secret)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9~._\\-]{34,40}\\b", "label": "Azure AD client secret", "group": "Cloud", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure", "vendor_icon": "microsoftazure"},
    {"name": "azure_openai_key_ctx", "tier": "A", "regex": "(?i)(?:azure_openai_(?:api_)?key|foundry_(?:api_)?key|cognitive[a-z_]*key)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9]{32,84}\\b", "label": "Azure OpenAI / AI Foundry key", "group": "Cloud", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure OpenAI", "vendor_icon": "microsoftazure"},
    {"name": "gcp_client_secret", "tier": "A", "regex": "\\bGOCSPX-[A-Za-z0-9_\\-]{28}\\b", "label": "Google OAuth client secret", "group": "Cloud", "revoke": {"where": "Google Cloud credentials", "url": "https://console.cloud.google.com/apis/credentials"}, "vendor": "Google Cloud", "vendor_icon": "googlecloud"},
    {"name": "gcp_oauth_access_token", "tier": "A", "regex": "\\bya29\\.[0-9A-Za-z_\\-]{50,}", "label": "Google OAuth access token", "group": "Cloud", "revoke": {"where": "Google Cloud credentials", "url": "https://console.cloud.google.com/apis/credentials"}, "vendor": "Google Cloud", "vendor_icon": "googlecloud"},
    {"name": "gcp_oauth_refresh_token", "tier": "A", "regex": "\\b1//0[0-9A-Za-z_\\-]{50,}", "label": "Google OAuth refresh token", "group": "Cloud", "revoke": {"where": "Google Cloud credentials", "url": "https://console.cloud.google.com/apis/credentials"}, "vendor": "Google Cloud", "vendor_icon": "googlecloud"},
    {"name": "google_oauth_auth_code", "tier": "B", "regex": "\\b4(?:/|%2F)0A[A-Za-z0-9_\\-]{40,}", "label": "Google OAuth authorization code", "group": "Cloud", "vendor": "Google", "vendor_icon": "google"},
    {"name": "gcp_sa_private_key_id", "tier": "A", "regex": "\\\"private_key_id\\\"\\s*:\\s*\\\"[a-f0-9]{40}\\\"", "label": "Google service account key", "group": "Cloud", "vendor": "Google Cloud", "vendor_icon": "googlecloud"},
    {"name": "gcp_service_account_json", "tier": "B", "regex": "\\\"type\\\"\\s*:\\s*\\\"service_account\\\"", "label": "Google service account JSON", "group": "Cloud", "vendor": "Google Cloud", "vendor_icon": "googlecloud"},
    {"name": "google_session_cookie_ctx", "tier": "A", "regex": "\\b(?:__Secure-[13]PSID[A-Z]*|SAPISID|APISID|HSID|SSID|SID)[\\\"']?\\s*[:=,]\\s*[\\\"']?(?:value[\\\"']?\\s*:\\s*[\\\"']?)?[A-Za-z0-9_\\-./]{40,}", "label": "Google session cookie", "group": "Cloud", "session_cookie": true, "vendor": "Google", "vendor_icon": "google"},
    {"name": "digitalocean_token", "tier": "A", "regex": "\\bdo[opr]_v1_[a-f0-9]{64}\\b", "label": "DigitalOcean token", "group": "Cloud", "revoke": {"where": "DigitalOcean API", "url": "https://cloud.digitalocean.com/account/api/tokens"}, "vendor": "DigitalOcean", "vendor_icon": "digitalocean"},
    {"name": "cloudflare_token_ctx", "tier": "A", "regex": "(?i)cloudflare[a-z_]*(?:token|key)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-]{37,40}\\b", "label": "Cloudflare API token", "group": "Cloud", "revoke": {"where": "Cloudflare API tokens", "url": "https://dash.cloudflare.com/profile/api-tokens"}, "vendor": "Cloudflare", "vendor_icon": "cloudflare"},
    {"name": "vercel_token_ctx", "tier": "A", "regex": "(?i)vercel[a-z_]*token[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9]{24}\\b", "label": "Vercel token", "group": "Cloud", "revoke": {"where": "Vercel tokens", "url": "https://vercel.com/account/settings/tokens"}, "vendor": "Vercel", "vendor_icon": "vercel"},
    {"name": "netlify_token_ctx", "tier": "A", "regex": "(?i)netlify[a-z_]*token[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-]{40,}", "label": "Netlify token", "group": "Cloud", "vendor": "Netlify", "vendor_icon": "netlify"},
    {"name": "flyio_token", "tier": "A", "regex": "\\bfo1_[A-Za-z0-9_\\-]{40,}", "label": "Fly.io token", "group": "Cloud", "vendor": "Fly.io", "vendor_icon": "flydotio"},
    {"name": "terraform_cloud_token", "tier": "A", "regex": "\\b[A-Za-z0-9]{14}\\.atlasv1\\.[A-Za-z0-9_\\-]{60,}", "label": "Terraform Cloud token", "group": "Cloud", "vendor": "HashiCorp Terraform", "vendor_icon": "terraform"},
    {"name": "heroku_key_ctx", "tier": "A", "regex": "(?i)heroku[a-z_]*key[\\\"']?\\s*[:=]\\s*[\\\"']?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\b", "label": "Heroku API key", "group": "Cloud", "vendor": "Heroku", "vendor_icon": "heroku"},
    {"name": "railway_token_ctx", "tier": "A", "regex": "(?i)railway[a-z_]*token[\\\"']?\\s*[:=]\\s*[\\\"']?[0-9a-f\\-]{36}\\b", "label": "Railway token", "group": "Cloud", "vendor": "Railway", "vendor_icon": "railway"},
    {"name": "supabase_service_key_ctx", "tier": "A", "regex": "(?i)(?:supabase_service_role_key|service_role)[\\\"']?\\s*[:=]\\s*[\\\"']?eyJ[A-Za-z0-9_\\-.]{50,}", "label": "Supabase service role key", "group": "Cloud", "vendor": "Supabase", "vendor_icon": "supabase"},
    {"name": "supabase_secret_key", "tier": "A", "regex": "\\bsb_secret_[A-Za-z0-9_\\-]{20,}", "label": "Supabase secret key", "group": "Cloud", "vendor": "Supabase", "vendor_icon": "supabase"},
    {"name": "github_token", "tier": "A", "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b", "label": "GitHub token", "group": "VCS / package registries", "revoke": {"where": "GitHub tokens", "url": "https://github.com/settings/tokens"}, "vendor": "GitHub", "vendor_icon": "github"},
    {"name": "github_fine_grained_pat", "tier": "A", "regex": "\\bgithub_pat_[A-Za-z0-9_]{80,}\\b", "label": "GitHub fine-grained token", "group": "VCS / package registries", "revoke": {"where": "GitHub fine-grained tokens", "url": "https://github.com/settings/personal-access-tokens"}, "vendor": "GitHub", "vendor_icon": "github"},
    {"name": "gitlab_token", "tier": "A", "regex": "\\bgl(?:pat|dt|rt|ptt|cbt|oas)-[A-Za-z0-9_\\-]{20,}", "label": "GitLab token", "group": "VCS / package registries", "revoke": {"where": "GitLab access tokens", "url": "https://gitlab.com/-/user_settings/personal_access_tokens"}, "vendor": "GitLab", "vendor_icon": "gitlab"},
    {"name": "bitbucket_ctx", "tier": "A", "regex": "(?i)bitbucket[a-z_]*(?:password|token)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-]{20,}", "label": "Bitbucket app password or token", "group": "VCS / package registries", "vendor": "Bitbucket", "vendor_icon": "bitbucket"},
    {"name": "npm_token", "tier": "A", "regex": "\\bnpm_[A-Za-z0-9]{36}\\b", "label": "npm token", "group": "VCS / package registries", "revoke": {"where": "npm access tokens", "url": "https://www.npmjs.com/settings/~/tokens"}, "vendor": "npm", "vendor_icon": "npm"},
    {"name": "npmrc_auth_token", "tier": "A", "regex": "_authToken\\s*=\\s*[A-Za-z0-9_\\-.]{20,}", "label": "npm auth token (.npmrc)", "group": "VCS / package registries", "revoke": {"where": "npm access tokens", "url": "https://www.npmjs.com/settings/~/tokens"}, "vendor": "npm", "vendor_icon": "npm"},
    {"name": "pypi_token", "tier": "A", "regex": "\\bpypi-AgEIcHlwaS5vcmc[A-Za-z0-9_\\-]{50,}", "label": "PyPI API token", "group": "VCS / package registries", "revoke": {"where": "PyPI API tokens", "url": "https://pypi.org/manage/account/token/"}, "vendor": "PyPI", "vendor_icon": "pypi"},
    {"name": "rubygems_key", "tier": "A", "regex": "\\brubygems_[a-f0-9]{48}\\b", "label": "RubyGems API key", "group": "VCS / package registries", "vendor": "RubyGems", "vendor_icon": "rubygems"},
    {"name": "dockerhub_pat", "tier": "A", "regex": "\\bdckr_pat_[A-Za-z0-9_\\-]{27,}", "label": "Docker Hub access token", "group": "VCS / package registries", "revoke": {"where": "Docker Hub tokens", "url": "https://app.docker.com/settings/personal-access-tokens"}, "vendor": "Docker Hub", "vendor_icon": "docker"},
    {"name": "jfrog_access_token", "tier": "A", "regex": "\\bAKCp[A-Za-z0-9]{69,}\\b", "label": "JFrog access token", "group": "VCS / package registries", "vendor": "JFrog", "vendor_icon": "jfrog"},
    {"name": "jfrog_reference_token", "tier": "A", "regex": "\\bcmVmdG9rZW46[A-Za-z0-9+/=]{20,}", "label": "JFrog reference token", "group": "VCS / package registries", "vendor": "JFrog", "vendor_icon": "jfrog"},
    {"name": "jfrog_ctx", "tier": "A", "regex": "(?i)(?:artifactory|jfrog)[a-z_]*(?:api_?key|token|password)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-.]{40,}", "label": "JFrog Artifactory credential", "group": "VCS / package registries", "vendor": "JFrog", "vendor_icon": "jfrog"},
    {"name": "slack_token", "tier": "A", "regex": "\\bxox[abposre]-[A-Za-z0-9\\-]{10,}", "label": "Slack token", "group": "Comms / SaaS", "revoke": {"where": "Slack apps", "url": "https://api.slack.com/apps"}, "vendor": "Slack", "vendor_icon": "slack"},
    {"name": "slack_webhook", "tier": "A", "regex": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9_]{6,}/B[A-Za-z0-9_]{6,}/[A-Za-z0-9_]{20,}", "label": "Slack webhook URL", "group": "Comms / SaaS", "revoke": {"where": "Slack apps", "url": "https://api.slack.com/apps"}, "vendor": "Slack", "vendor_icon": "slack"},
    {"name": "discord_bot_token", "tier": "A", "regex": "\\b[MNO][A-Za-z0-9_\\-]{23,26}\\.[A-Za-z0-9_\\-]{6}\\.[A-Za-z0-9_\\-]{27,38}\\b", "label": "Discord bot token", "group": "Comms / SaaS", "revoke": {"where": "Discord developer portal", "url": "https://discord.com/developers/applications"}, "vendor": "Discord", "vendor_icon": "discord"},
    {"name": "discord_webhook", "tier": "A", "regex": "https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/[0-9]{17,20}/[A-Za-z0-9_\\-]{60,}", "label": "Discord webhook URL", "group": "Comms / SaaS", "revoke": {"where": "Discord developer portal", "url": "https://discord.com/developers/applications"}, "vendor": "Discord", "vendor_icon": "discord"},
    {"name": "telegram_bot_token", "tier": "A", "regex": "\\b[0-9]{8,10}:AA[A-Za-z0-9_\\-]{33}\\b", "label": "Telegram bot token", "group": "Comms / SaaS", "revoke": {"where": "Telegram @BotFather (/revoke)", "url": "https://t.me/BotFather"}, "vendor": "Telegram", "vendor_icon": "telegram"},
    {"name": "twilio_ctx", "tier": "A", "regex": "(?i)twilio[a-z_]*(?:auth_?token|api_?secret)[\\\"']?\\s*[:=]\\s*[\\\"']?[a-f0-9]{32}\\b", "label": "Twilio auth token", "group": "Comms / SaaS", "vendor": "Twilio", "vendor_icon": "twilio"},
    {"name": "twilio_api_key_sid", "tier": "B", "regex": "\\bSK[a-f0-9]{32}\\b", "label": "Twilio API key SID", "group": "Comms / SaaS", "vendor": "Twilio", "vendor_icon": "twilio"},
    {"name": "sendgrid_key", "tier": "A", "regex": "\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b", "label": "SendGrid API key", "group": "Comms / SaaS", "revoke": {"where": "SendGrid API keys", "url": "https://app.sendgrid.com/settings/api_keys"}, "vendor": "SendGrid"},
    {"name": "mailgun_key", "tier": "A", "regex": "\\bkey-[a-f0-9]{32}\\b", "label": "Mailgun API key", "group": "Comms / SaaS", "vendor": "Mailgun"},
    {"name": "mailchimp_key", "tier": "A", "regex": "\\b[a-f0-9]{32}-us[0-9]{1,2}\\b", "label": "Mailchimp API key", "group": "Comms / SaaS", "vendor": "Mailchimp", "vendor_icon": "mailchimp"},
    {"name": "resend_key", "tier": "A", "regex": "\\bre_[A-Za-z0-9]{8}_[A-Za-z0-9]{24}\\b", "label": "Resend API key", "group": "Comms / SaaS", "vendor": "Resend", "vendor_icon": "resend"},
    {"name": "postmark_ctx", "tier": "A", "regex": "(?i)postmark[a-z_]*token[\\\"']?\\s*[:=]\\s*[\\\"']?[0-9a-f\\-]{36}\\b", "label": "Postmark server token", "group": "Comms / SaaS", "vendor": "Postmark"},
    {"name": "stripe_secret_key", "tier": "A", "regex": "\\b[sr]k_(?:live|test)_[0-9A-Za-z]{20,}\\b", "label": "Stripe secret key", "group": "Comms / SaaS", "revoke": {"where": "Stripe API keys", "url": "https://dashboard.stripe.com/apikeys"}, "vendor": "Stripe", "vendor_icon": "stripe"},
    {"name": "stripe_webhook_secret", "tier": "A", "regex": "\\bwhsec_[A-Za-z0-9]{32,}\\b", "label": "Stripe webhook secret", "group": "Comms / SaaS", "revoke": {"where": "Stripe API keys", "url": "https://dashboard.stripe.com/apikeys"}, "vendor": "Stripe", "vendor_icon": "stripe"},
    {"name": "square_token", "tier": "A", "regex": "\\b(?:sq0atp|sq0csp)-[A-Za-z0-9_\\-]{22,}\\b|\\bEAAA[A-Za-z0-9_\\-]{60}\\b", "label": "Square access token", "group": "Comms / SaaS", "vendor": "Square", "vendor_icon": "square"},
    {"name": "shopify_token", "tier": "A", "regex": "\\bshp(?:at|ca|pa|ss)_[a-fA-F0-9]{32}\\b", "label": "Shopify access token", "group": "Comms / SaaS", "vendor": "Shopify", "vendor_icon": "shopify"},
    {"name": "airtable_key", "tier": "A", "regex": "\\bkey[A-Za-z0-9]{14}\\b|\\bpat[A-Za-z0-9]{14}\\.[a-f0-9]{64}\\b", "label": "Airtable API key", "group": "Comms / SaaS", "vendor": "Airtable", "vendor_icon": "airtable"},
    {"name": "asana_pat", "tier": "A", "regex": "\\b[12]/[0-9]{16}(?:/[0-9]{16})?:[a-f0-9]{32}\\b", "label": "Asana personal access token", "group": "Comms / SaaS", "vendor": "Asana", "vendor_icon": "asana"},
    {"name": "atlassian_api_token", "tier": "A", "regex": "\\bATATT3[A-Za-z0-9_\\-=]{100,}", "label": "Atlassian API token", "group": "Comms / SaaS", "revoke": {"where": "Atlassian API tokens", "url": "https://id.atlassian.com/manage-profile/security/api-tokens"}, "vendor": "Atlassian", "vendor_icon": "atlassian"},
    {"name": "atlassian_ctx", "tier": "A", "regex": "(?i)(?:jira|confluence|atlassian)[a-z_]*(?:token|password)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-=]{20,}", "label": "Atlassian (Jira/Confluence) credential", "group": "Comms / SaaS", "revoke": {"where": "Atlassian API tokens", "url": "https://id.atlassian.com/manage-profile/security/api-tokens"}, "vendor": "Atlassian", "vendor_icon": "atlassian"},
    {"name": "notion_token", "tier": "A", "regex": "\\b(?:secret_[A-Za-z0-9]{43}|ntn_[A-Za-z0-9]{40,})\\b", "label": "Notion integration token", "group": "Comms / SaaS", "revoke": {"where": "Notion integrations", "url": "https://www.notion.so/profile/integrations"}, "vendor": "Notion", "vendor_icon": "notion"},
    {"name": "linear_key", "tier": "A", "regex": "\\blin_api_[A-Za-z0-9]{40}\\b", "label": "Linear API key", "group": "Comms / SaaS", "revoke": {"where": "Linear API settings", "url": "https://linear.app/settings/account/security"}, "vendor": "Linear", "vendor_icon": "linear"},
    {"name": "figma_token", "tier": "A", "regex": "\\bfigd_[A-Za-z0-9_\\-]{40,}", "label": "Figma access token", "group": "Comms / SaaS", "vendor": "Figma", "vendor_icon": "figma"},
    {"name": "sentry_dsn", "tier": "A", "regex": "https://[a-f0-9]{32}@[a-z0-9.\\-]*sentry\\.io/[0-9]+", "label": "Sentry DSN", "group": "Comms / SaaS", "vendor": "Sentry", "vendor_icon": "sentry"},
