    {"name": "brave_api_key_ctx", "tier": "A", "regex": "(?i)brave[a-z_]*key[\\\"']?\\s*[:=]\\s*[\\\"']?BSA[A-Za-z0-9_\\-]{25,32}\\b", "label": "Brave Search API key", "group": "Comms / SaaS", "revoke": {"where": "Brave Search API", "url": "https://api-dashboard.search.brave.com/app/keys"}, "vendor": "Brave Search", "vendor_icon": "brave"},
