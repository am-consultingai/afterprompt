    {"name": "linkedin_li_at_ctx", "tier": "A", "regex": "(?i)\\bli_at[\\\"']?\\s*[:=,]\\s*[\\\"']?(?:value[\\\"']?\\s*:\\s*[\\\"']?)?AQED[A-Za-z0-9_\\-]{100,}", "label": "LinkedIn session cookie", "group": "Comms / SaaS", "session_cookie": true, "vendor": "LinkedIn", "vendor_icon": "linkedin"},
