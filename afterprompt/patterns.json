    {"name": "whatsapp_gateway_ctx", "tier": "A", "regex": "(?i)(?:green[-_]?api|ultramsg|wati|whatsapp|waba|360dialog|maytapi|wassenger)[a-z_]*(?:token|key|secret)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-]{20,}", "label": "WhatsApp gateway token", "group": "Meta / WhatsApp / Google / registrars / payment + messaging", "vendor": "WhatsApp", "vendor_icon": "whatsapp"},
