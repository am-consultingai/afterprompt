    {"name": "teams_webhook", "tier": "A", "regex": "https://[a-z0-9\\-]+\\.webhook\\.office\\.com/webhookb2/[A-Za-z0-9@\\-]{30,}/IncomingWebhook/[A-Za-z0-9]{32}/[A-Za-z0-9\\-]{36}", "label": "Microsoft Teams webhook URL", "group": "Meta / WhatsApp / Google / registrars / payment + messaging", "vendor": "Microsoft Teams", "vendor_icon": "microsoftteams"},
    {"name": "zapier_webhook", "tier": "B", "regex": "https://hooks\\.zapier\\.com/hooks/catch/[0-9]+/[A-Za-z0-9]+", "label": "Zapier webhook URL", "group": "Meta / WhatsApp / Google / registrars / payment + messaging", "vendor": "Zapier", "vendor_icon": "zapier"},
    {"name": "make_webhook", "tier": "B", "regex": "https://hook\\.(?:[a-z0-9]+\\.)?make\\.com/[a-z0-9]{32}", "label": "Make webhook URL", "group": "Meta / WhatsApp / Google / registrars / payment + messaging", "vendor": "Make", "vendor_icon": "make"},
    {"name": "pkcs8_rsa_key_body", "tier": "A", "regex": "\\bMII[A-Za-z0-9+/]{3}IBADANBgkqhkiG9w0BAQEFAASC", "label": "RSA private key", "group": "private keys without PEM headers (base64 DER bodies)", "header_only": true},
