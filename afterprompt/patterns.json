    {"name": "openssh_key_body", "tier": "A", "regex": "\\bb3BlbnNzaC1rZXktdjE[A-Za-z0-9+/]{60,}", "label": "OpenSSH private key", "group": "private keys without PEM headers (base64 DER bodies)"},
    {"name": "private_key_pem_multiline", "tier": "A", "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----\\r?\\n[A-Za-z0-9+/=]{40,}", "label": "Private key", "group": "private keys without PEM headers (base64 DER bodies)", "multiline": true},
    {"name": "http_header_key", "tier": "B", "regex": "(?i)\\b(?:x-api-key|api-key|x-auth-token|x-access-token|x-goog-api-key|xi-api-key|ocp-apim-subscription-key|x-functions-key|subscription-key|private-token|x-api-token|x-app-token|x-client-secret|apikey)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-+/=.~]{16,}", "label": "API key in HTTP header", "group": "structural: headers, cookies, CLI flags, URL params, prose", "rotate_structural": true},
    {"name": "bearer_literal", "tier": "B", "regex": "(?i)[\\\"'`]Bearer\\s+[A-Za-z0-9_\\-.=+/]{24,}[\\\"'`]", "label": "Bearer token", "group": "structural: headers, cookies, CLI flags, URL params, prose", "rotate_structural": true},
    {"name": "cookie_header", "tier": "B", "regex": "(?i)\\b(?:cookie|set-cookie)[\\\"']?\\s*[:=]\\s*[\\\"']?(?:[^\\\"'\\r\\n;]{1,100};\\s*){0,12}[A-Za-z0-9_.\\-]{2,40}=[A-Za-z0-9%_\\-+/.=:]{32,}", "label": "Cookie header", "group": "structural: headers, cookies, CLI flags, URL params, prose", "session_cookie": true},
    {"name": "curl_cookie_flag", "tier": "B", "regex": "(?:\\s-b|--cookie)\\s+[\\\"'][^\\\"']{0,200}=[A-Za-z0-9%_\\-+/.=]{32,}", "label": "Cookie passed to curl", "group": "structural: headers, cookies, CLI flags, URL params, prose", "session_cookie": true},
    {"name": "cli_secret_flag", "tier": "B", "regex": "--(?:password|passwd|pass|token|api-key|apikey|secret|client-secret|access-key|secret-key|auth-token)(?:=|\\s+)[\\\"']?[^\\s\\\"'$<{\\-][^\\s\\\"']{5,}", "label": "Secret passed as a command-line flag", "group": "structural: headers, cookies, CLI flags, URL params, prose"},
    {"name": "sshpass_mysql_flag", "tier": "B", "regex": "\\bsshpass\\s+-p\\s*[\\\"']?[^\\s\\\"']{4,}|\\bmysql(?:dump|admin)?\\s[^\\n|;]{0,80}\\s-p[^\\s\\\"'\\-][^\\s\\\"']{3,}", "label": "Password passed to sshpass or mysql", "group": "structural: headers, cookies, CLI flags, URL params, prose", "rotate_structural": true},
    {"name": "url_secret_param", "tier": "B", "regex": "[?&](?:access_token|api_key|apikey|api-key|token|auth_token|secret|client_secret|password|passwd|pwd|key|code|signature|x-amz-signature|x-goog-signature)=[A-Za-z0-9_\\-%.~+/=]{20,}", "label": "Secret in URL parameter", "group": "structural: headers, cookies, CLI flags, URL params, prose"},
    {"name": "requests_basic_auth", "tier": "B", "regex": "(?i)\\bauth\\s*=\\s*\\(\\s*[\\\"'][^\\\"']{2,}[\\\"']\\s*,\\s*[\\\"'][^\\\"']{6,}[\\\"']\\s*\\)", "label": "Username and password in code", "group": "structural: headers, cookies, CLI flags, URL params, prose", "rotate_structural": true},
    {"name": "user_password_pair", "tier": "B", "regex": "(?i)\\b(?:user(?:name)?|login|email)\\s*[:=]\\s*\\S{3,}\\s*[,;/|]?\\s*(?:pass(?:word)?|pwd)\\s*[:=]\\s*[^\\s\\\"']{6,}", "label": "Username and password", "group": "structural: headers, cookies, CLI flags, URL params, prose"},
    {"name": "hebrew_password_prose", "tier": "C", "regex": "(?:סיסמ[הא]|סיסמת\\S*|קוד\\s+(?:גישה|כניסה|אימות)|טוקן|מפתח\\s+(?:API|api|גישה|סודי))\\s*(?:היא|הוא|זה|:|=|-|–)?\\s*[`\\\"'׳״]?[^\\s`\\\"'׳״]{6,}", "label": "Password written in a prompt (Hebrew)", "group": "structural: headers, cookies, CLI flags, URL params, prose"},
    {"name": "apps_script_deployment_id", "tier": "C", "regex": "\\bAKfycb[A-Za-z0-9_\\-]{40,}", "label": "Apps Script deployment ID", "group": "structural: headers, cookies, CLI flags, URL params, prose", "vendor": "Google Apps Script", "vendor_icon": "google"},
    {"name": "env_assignment", "tier": "C", "regex": "(?i)\\b[A-Z0-9_]*(?:SECRET|TOKEN|PASSWORD|PASSWD|PASSPHRASE|APIKEY|API_KEY|PRIVATE_KEY|CREDENTIAL|ACCESS_KEY|AUTH_KEY|CLIENT_SECRET)[A-Z0-9_]*[\\\"']?\\s*[:=]\\s*[\\\"']?[^\\s\\\"'&;,}{)(\\]\\[<>]{8,}", "label": "Secret-named variable assignment", "group": "structural: headers, cookies, CLI flags, URL params, prose"},
    {"name": "generic_hex_secret", "tier": "C", "regex": "(?i)(?:secret|token|api_?key|password|signing_?key)[\\\"']?\\s*[:=]\\s*[\\\"']?[a-f0-9]{32,128}\\b", "label": "Hex secret", "group": "structural: headers, cookies, CLI flags, URL params, prose"},
