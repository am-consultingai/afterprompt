    {"name": "conn_string_password", "tier": "B", "regex": "(?i)(?:^|[;\\\"'\\s])(?:Password|Pwd)\\s*=\\s*[^;\\\"'\\s]{6,}(?:;|$)", "label": "Connection string password", "group": "Microsoft / Azure formats", "rotate_structural": true},
    {"name": "meta_access_token", "tier": "A", "regex": "\\bEAA[A-Za-z0-9]{90,}", "label": "Meta (Facebook/WhatsApp) access token", "group": "Meta / WhatsApp / Google / registrars / payment + messaging", "vendor": "Meta", "vendor_icon": "meta"},
