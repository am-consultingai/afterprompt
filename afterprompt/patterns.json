    {"name": "salesforce_session", "tier": "A", "regex": "\\b00D[A-Za-z0-9]{12,15}![A-Za-z0-9._]{80,}", "label": "Salesforce session ID", "group": "Comms / SaaS", "session_cookie": true, "vendor": "Salesforce", "vendor_icon": "salesforce"},
