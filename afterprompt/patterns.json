    {"name": "azure_identifiable_b64_88", "tier": "A", "regex": "[A-Za-z0-9+/]{76}(?:\\+AS[bt]|\\+AEh|\\+ARm|AzCa|AzFu|ACDb|APIM|AzSe)[A-Za-z0-9+/]{5}[AQgw]==", "label": "Azure access key", "group": "Microsoft / Azure formats", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure", "vendor_icon": "microsoftazure"},
    {"name": "azure_shared_access_key", "tier": "A", "regex": "(?i)\\bSharedAccessKey=[A-Za-z0-9+/]{40,}={0,2}", "label": "Azure shared access key", "group": "Microsoft / Azure formats", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Azure", "vendor_icon": "microsoftazure"},
