    {"name": "age_secret_key", "tier": "A", "regex": "\\bAGE-SECRET-KEY-1[0-9A-Z]{58}\\b", "label": "age secret key", "group": "Keys / structural"},
    {"name": "jwt", "tier": "B", "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}", "label": "JSON Web Token", "group": "Keys / structural"},
    {"name": "basic_auth_header", "tier": "B", "regex": "(?i)authorization[\\\"']?\\s*[:=]\\s*[\\\"']?basic\\s+[A-Za-z0-9+/=]{16,}", "label": "HTTP Basic credentials", "group": "Keys / structural", "rotate_structural": true},
    {"name": "bearer_header", "tier": "B", "regex": "(?i)authorization[\\\"']?\\s*[:=]\\s*[\\\"']?bearer\\s+[A-Za-z0-9_\\-.=+/]{24,}", "label": "Bearer token", "group": "Keys / structural", "rotate_structural": true},
    {"name": "curl_user_flag", "tier": "B", "regex": "(?:-u|--user)\\s+[\\\"']?[^\\s:\\\"']{2,}:[^\\s\\\"']{6,}", "label": "curl username and password", "group": "Keys / structural", "rotate_structural": true},
    {"name": "url_with_credentials", "tier": "B", "regex": "\\b(?:https?|postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|amqps?|ftp|sftp|smtps?|imaps?|ldaps?)://[^:@/\\s\\\"'<>]{1,64}:[^@/\\s\\\"'<>]{3,128}@", "label": "URL with embedded password", "group": "Keys / structural", "rotate_structural": true},
    {"name": "prefixed_key", "tier": "B", "regex": "\\b(?:sk|pk|rk|ak|api|key|tok|token|secret)[0-9]?_[A-Za-z0-9]{24,}\\b", "label": "Prefixed API key", "group": "Keys / structural"},
    {"name": "htpasswd_hash", "tier": "B", "regex": "\\$(?:2[aby]|apr1|6|5)\\$[A-Za-z0-9./$]{20,}", "label": "Password hash", "group": "Keys / structural"},
    {"name": "entra_client_secret", "tier": "A", "regex": "\\b[A-Za-z0-9_~.]{3}[0-9]Q~[A-Za-z0-9_~.\\-]{31,34}", "label": "Microsoft Entra client secret", "group": "Microsoft / Azure formats", "revoke": {"where": "Azure portal", "url": "https://portal.azure.com"}, "vendor": "Microsoft Entra", "vendor_icon": "microsoft"},
    {"name": "azure_devops_pat", "tier": "A", "regex": "\\b[A-Za-z0-9]{76}AZDO[A-Za-z0-9]{4}\\b", "label": "Azure DevOps personal access token", "group": "Microsoft / Azure formats", "revoke": {"where": "Azure DevOps token settings", "url": "https://learn.microsoft.com/en-us/azure/devops/organizations/accounts/use-personal-access-tokens-to-authenticate"}, "vendor": "Azure DevOps", "vendor_icon": "azuredevops"},
    {"name": "azure_devops_pat_ctx", "tier": "A", "regex": "(?i)(?:azure[_-]?devops|azdo|ado|devops)[a-z_]*(?:pat|token)[\\\"']?\\s*[:=]\\s*[\\\"']?[a-z2-7]{52}\\b", "label": "Azure DevOps personal access token", "group": "Microsoft / Azure formats", "revoke": {"where": "Azure DevOps token settings", "url": "https://learn.microsoft.com/en-us/azure/devops/organizations/accounts/use-personal-access-tokens-to-authenticate"}, "vendor": "Azure DevOps", "vendor_icon": "azuredevops"},
