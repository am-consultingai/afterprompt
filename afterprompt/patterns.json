    {"name": "google_chat_webhook", "tier": "A", "regex": "https://chat\\.googleapis\\.com/v1/spaces/[A-Za-z0-9_\\-]+/messages\\?key=[A-Za-z0-9_\\-]{30,}&token=[A-Za-z0-9_\\-%]{30,}", "label": "Google Chat webhook URL", "group": "Meta / WhatsApp / Google / registrars / payment + messaging", "vendor": "Google", "vendor_icon": "google"},
