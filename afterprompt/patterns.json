    {"name": "pkcs8_ec_key_body", "tier": "A", "regex": "\\bMIG[A-Za-z0-9+/]AgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG", "label": "EC private key", "group": "private keys without PEM headers (base64 DER bodies)", "header_only": true},
