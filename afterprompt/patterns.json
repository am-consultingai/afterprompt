    {"name": "session_cookie_ctx", "tier": "B", "regex": "(?i)\\b(?:sessionid|session_id|connect\\.sid|_session|auth_token|access_token)[\\\"']?\\s*[:=]\\s*[\\\"']?[A-Za-z0-9_\\-.%]{40,}", "label": "Session cookie or token", "group": "Comms / SaaS", "session_cookie": true},
    {"name": "private_key_pem_body", "tier": "A", "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----(?:\\\\\\\\n|\\\\n|\\s){1,4}[A-Za-z0-9+/]{60,}", "label": "Private key", "group": "Keys / structural"},
    {"name": "private_key_header", "tier": "B", "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY", "label": "Private key", "group": "Keys / structural", "header_only": true},
    {"name": "pgp_private_block", "tier": "A", "regex": "-----BEGIN PGP PRIVATE KEY BLOCK-----", "label": "PGP private key", "group": "Keys / structural", "header_only": true},
